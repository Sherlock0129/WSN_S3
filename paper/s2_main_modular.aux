\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces 向阳面簇头能量放大图（约 39--41.5k min 区间）：可分辨“控制/上报的窄脉冲下探”和“批量能量下发的较大阶跃”。CH0（蓝）与 CH1（红）在抖动频次上略有差异，对应时隙错位与控制开销差异。}}{12}{figure.13}\protected@file@percent }
\newlabel{fig:ch01-zoom}{{13}{12}{向阳面簇头能量放大图（约 39--41.5k min 区间）：可分辨“控制/上报的窄脉冲下探”和“批量能量下发的较大阶跃”。CH0（蓝）与 CH1（红）在抖动频次上略有差异，对应时隙错位与控制开销差异。}{figure.13}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces 阴面簇头（有 RIS）：轨迹呈“缓降+周期性回充”，所有簇全程存活。簇规模与斜率相关：CH3（最小簇，红）最缓，CH5（最大簇，紫）次之；CH4（绿）谷值更深、波动更大。}}{12}{figure.14}\protected@file@percent }
\newlabel{fig:ch2-5-ris}{{14}{12}{阴面簇头（有 RIS）：轨迹呈“缓降+周期性回充”，所有簇全程存活。簇规模与斜率相关：CH3（最小簇，红）最缓，CH5（最大簇，紫）次之；CH4（绿）谷值更深、波动更大。}{figure.14}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces 阴面簇头（无 RIS）：能量近线性快速衰减并先后枯竭。存活顺序与簇规模一致：CH4 最先，CH2/CH5 随后，CH3 最晚。几乎无“回充阶跃”，说明下发难以送达。}}{13}{figure.15}\protected@file@percent }
\newlabel{fig:ch2-5-noris}{{15}{13}{阴面簇头（无 RIS）：能量近线性快速衰减并先后枯竭。存活顺序与簇规模一致：CH4 最先，CH2/CH5 随后，CH3 最晚。几乎无“回充阶跃”，说明下发难以送达。}{figure.15}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {16}{\ignorespaces 传感器（有 RIS）：多数节点缓降并伴随周期性“上跳”。少量向阳面传感器近似高位稳定（采能占优）。阶跃在约 40k/80k/120k min 同步出现，反映簇头\,$\to $\,簇内的再分配/补能广播。}}{13}{figure.16}\protected@file@percent }
\newlabel{fig:sensors-ris}{{16}{13}{传感器（有 RIS）：多数节点缓降并伴随周期性“上跳”。少量向阳面传感器近似高位稳定（采能占优）。阶跃在约 40k/80k/120k min 同步出现，反映簇头\,$\to $\,簇内的再分配/补能广播。}{figure.16}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {\mbox  {V-G}3}簇内传感器能量：均衡化效应}{13}{figure.17}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {17}{\ignorespaces 传感器（无 RIS）：能量普遍单调下降，“上跳”稀少且幅度小；阴面远端节点下降更快、簇内差异随时间扩大。}}{13}{figure.17}\protected@file@percent }
\newlabel{fig:sensors-noris}{{17}{13}{传感器（无 RIS）：能量普遍单调下降，“上跳”稀少且幅度小；阴面远端节点下降更快、簇内差异随时间扩大。}{figure.17}{}}
